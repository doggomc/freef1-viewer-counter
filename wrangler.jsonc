{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freef1-viewer-counter",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIEWER_COUNTER_ROOM",
        "class_name": "ViewerCounterRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ViewerCounterRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://freef1.netlify.app"
  }
}
